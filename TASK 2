import math
import random
import time

def print_board(board):
    print("\n")
    for i in range(0, 9, 3):
        print(f"  {board[i]} | {board[i+1]} | {board[i+2]} ")
        if i < 6:
            print(" " + "-"*11)
    print("\n")

def check_winner(board, player):
    # All possible winning paths
    win_paths = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8], # Rows
        [0, 3, 6], [1, 4, 7], [2, 5, 8], # Columns
        [0, 4, 8], [2, 4, 6]             # Diagonals
    ]
    return any(all(board[cell] == player for cell in path) for path in win_paths)

def is_board_full(board):
    return ' ' not in board

def get_available_moves(board):
    return [i for i, spot in enumerate(board) if spot == ' ']

# The core AI brain
def minimax_alpha_beta(board, depth, alpha, beta, is_maximizing):
    # Base cases: Check for terminal states
    if check_winner(board, 'O'): return 10 - depth  # Reward faster wins
    if check_winner(board, 'X'): return depth - 10  # Penalize losing states
    if is_board_full(board): return 0

    if is_maximizing:
        best_score = -math.inf
        for move in get_available_moves(board):
            board[move] = 'O'
            score = minimax_alpha_beta(board, depth + 1, alpha, beta, False)
            board[move] = ' '
            best_score = max(score, best_score)
            alpha = max(alpha, score)
            if beta <= alpha:
                break # Prune the tree! Stop checking this branch.
        return best_score
    else:
        best_score = math.inf
        for move in get_available_moves(board):
            board[move] = 'X'
            score = minimax_alpha_beta(board, depth + 1, alpha, beta, True)
            board[move] = ' '
            best_score = min(score, best_score)
            beta = min(beta, score)
            if beta <= alpha:
                break # Prune the tree!
        return best_score

def get_ai_move(board, difficulty):
    if difficulty == 'easy':
        # AI just picks a random empty square
        return random.choice(get_available_moves(board))
    else:
        # Hard mode: Unbeatable Minimax
        best_score = -math.inf
        best_move = None
        for move in get_available_moves(board):
            board[move] = 'O'
            score = minimax_alpha_beta(board, 0, -math.inf, math.inf, False)
            board[move] = ' '
            if score > best_score:
                best_score = score
                best_move = move
        return best_move

def play_game():
    board = [' '] * 9
    print("🎮 Welcome to Tic-Tac-Toe AI 🎮")
    
    # Select difficulty
    difficulty = ''
    while difficulty not in ['easy', 'hard']:
        difficulty = input("Choose difficulty ('easy' or 'hard'): ").lower().strip()

    print("\nYou are 'X'. The AI is 'O'.")
    print("Board positions are numbered 0-8 from top-left to bottom-right:")
    print_board(['0', '1', '2', '3', '4', '5', '6', '7', '8'])
    print("=" * 30)

    while True:
        # Human Turn
        try:
            human_move = int(input("Your move (0-8): "))
            if human_move < 0 or human_move > 8 or board[human_move] != ' ':
                print("Invalid move. Try picking an empty spot between 0 and 8.")
                continue
        except ValueError:
            print("Please enter a valid number.")
            continue

        board[human_move] = 'X'
        print_board(board)

        if check_winner(board, 'X'):
            print("🏆 You win! (Wait, that's impossible on hard mode...)")
            break
        if is_board_full(board):
            print("🤝 It's a draw!")
            break

        # AI Turn
        print("🤖 AI is thinking...")
        time.sleep(0.5) # Adding a slight delay to make it feel like it's "thinking"
        
        ai_move = get_ai_move(board, difficulty)
        board[ai_move] = 'O'
        print_board(board)

        if check_winner(board, 'O'):
            print("💀 AI Wins! You have been defeated.")
            break
        if is_board_full(board):
            print("🤝 It's a draw!")
            break

# Run the game
play_game()
