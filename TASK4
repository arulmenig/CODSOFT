}
df_ratings = pd.DataFrame(ratings_matrix_data).set_index('User')

class ContentBasedRecommender:
    def __init__(self, movies_df):
        self.df = movies_df
        self.vectorizer = TfidfVectorizer(stop_words='english')
        self.tfidf_matrix = self.vectorizer.fit_transform(self.df['metadata'])
        self.sim_matrix = cosine_similarity(self.tfidf_matrix, self.tfidf_matrix)
        
    def recommend(self, movie_title, top_n=2):
        try:
            idx = self.df[self.df['title'].str.lower() == movie_title.lower()].index[0]
        except IndexError:
            return [f"Movie '{movie_title}' not found in catalog."]
        
        sim_scores = list(enumerate(self.sim_matrix[idx]))
        sim_scores = sorted(sim_scores, key=lambda x: x[1], reverse=True)
        
        recommendations = []
        for i, score in sim_scores:
            if i != idx:
                recommendations.append((self.df.iloc[i]['title'], round(score, 3)))
            if len(recommendations) == top_n:
                break
        return recommendations

class CollaborativeRecommender:
    def __init__(self, ratings_df, movies_df):
        self.df_ratings = ratings_df
        self.df_movies = movies_df
        self.normalized_ratings = self.df_ratings.apply(lambda row: row.fillna(row.mean()), axis=1)
        self.user_sim_matrix = pd.DataFrame(
            cosine_similarity(self.normalized_ratings),
            index=self.df_ratings.index,
            columns=self.df_ratings.index
        )

    def recommend(self, target_user, top_n=2):
        if target_user not in self.df_ratings.index:
            return f"User '{target_user}' not found."
            
        user_ratings = self.df_ratings.loc[target_user]
        unwatched_movies = user_ratings[user_ratings.isna()].index.tolist()
        
        if not unwatched_movies:
            return "User has already rated all available movies!"
            
        predicted_ratings = {}
        
        for movie in unwatched_movies:
            other_users = self.df_ratings[self.df_ratings[movie].notna()].index
            numerator = 0
            denominator = 0
            
            for other_user in other_users:
                similarity = self.user_sim_matrix.loc[target_user, other_user]
                rating = self.df_ratings.loc[other_user, movie]
                numerator += similarity * rating
                denominator += similarity
                
            predicted_ratings[movie] = numerator / denominator if denominator != 0 else 0
            
        sorted_predictions = sorted(predicted_ratings.items(), key=lambda x: x[1], reverse=True)[:top_n]
        
        recommendations = []
        for movie_id, pred_score in sorted_predictions:
            title = self.df_movies[self.df_movies['movie_id'] == movie_id]['title'].values[0]
            recommendations.append((title, round(pred_score, 2)))
            
        return recommendations

print("🎬 INITIALIZING RECOMMENDATION SYSTEMS 🎬\n")

content_eng = ContentBasedRecommender(df_movies)
collab_eng = CollaborativeRecommender(df_ratings, df_movies)

test_movie = "The Conjuring"
print(f"1️⃣ [Content-Based] Because you watched '{test_movie}':")
cb_recs = content_eng.recommend(test_movie, top_n=2)
